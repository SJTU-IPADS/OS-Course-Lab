# Copy to .env (git-ignored) and fill in. The live preview injects these
# variables into every demo it runs; the slides never show the values.
# A variable already set in the shell wins over this file.

# Token of the course GPU server (lectures/5-gpu, page "课程服务器上的运行").
GPU_TOKEN=

