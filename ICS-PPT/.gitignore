__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.DS_Store
build/
*.egg-info/
node_modules/
package-lock.json
package.json
.superpowers/
.claude/settings.local.json
.claude/worktrees/

# What a `p.demo(...)` leaves behind. The compile demos in lectures/1-intro
# build in place, on purpose -- the point of the page is that you can look at
# the .i, the .s and the .o afterwards -- so the products are ignored and the
# sources beside them are not.
lectures/*/examples/*.i
lectures/*/examples/*.s
lectures/*/examples/*.o
lectures/*/examples/mini_ollama
lectures/*/examples/cpp_demo

# lectures/2-data/examples: every .c beside a demo compiles to a bare binary
# with the same name. The sources and tiny.gguf are kept; the binaries are not.
lectures/2-data/examples/bf16
lectures/2-data/examples/bitset_demo
lectures/2-data/examples/bool_c
lectures/2-data/examples/bool_cc
lectures/2-data/examples/compare
lectures/2-data/examples/float_law
lectures/2-data/examples/fp16_range
lectures/2-data/examples/gguf_head
lectures/2-data/examples/int4
lectures/2-data/examples/quantize
lectures/2-data/examples/rounding
lectures/2-data/examples/show_bytes
lectures/2-data/examples/sizes
lectures/2-data/examples/truncate

# lectures/3-asm/examples: same rule -- every source beside a demo compiles to
# a bare binary with the same name. .cu files build with nvcc, .sh builds the
# per-ISA objects that isa_width.sh counts.
lectures/3-asm/examples/divergence
lectures/3-asm/examples/divmul
lectures/3-asm/examples/echo_nopro
lectures/3-asm/examples/echo_pro
lectures/3-asm/examples/gpu_reduce
lectures/3-asm/examples/linear_bench
lectures/3-asm/examples/linear_cuda
lectures/3-asm/examples/movsz
lectures/3-asm/examples/structs
lectures/3-asm/examples/vnni
lectures/3-asm/examples/width-*

# lectures/4-cpu/examples: same rule again. linear.o is not covered by the
# *.o line above only because that line is what produces it, so it is listed
# here for the reader's sake.
lectures/4-cpu/examples/accum
lectures/4-cpu/examples/branch
lectures/4-cpu/examples/cycles
lectures/4-cpu/examples/depth
lectures/4-cpu/examples/linear_cpi
lectures/4-cpu/examples/ooo

# lectures/5-linking/examples: same rule again, plus the archives and shared
# objects the linking demos build. The .o files here are the subject of the
# lecture rather than a by-product, but they are reproducible from the .c
# beside them, so the *.o line above still covers them.
lectures/5-linking/examples/maps
lectures/5-linking/examples/prog
lectures/5-linking/examples/prog-static
lectures/5-linking/examples/layer2.c
lectures/5-linking/examples/dyn/dispatch
lectures/5-linking/examples/ggml/score
lectures/5-linking/examples/lib/infer
lectures/5-linking/examples/preload/work
lectures/5-linking/examples/so/infer
lectures/5-linking/examples/so/infer-lazy
lectures/5-linking/examples/weak/scale
lectures/*/examples/*.a
lectures/*/examples/*/*.a
lectures/*/examples/*/*.so
lectures/*/examples/*/*.o

# lectures/5-linking/mini-jit: the lab's build products. model/layer*.c is
# generated by gen_layers.py but stays in the tree — without it `make` has
# nothing to compile on a fresh checkout.
lectures/5-linking/mini-jit/mini-jit
lectures/5-linking/mini-jit/mini-jit-ref
lectures/5-linking/mini-jit/mini-jit-b[1-9]
lectures/5-linking/mini-jit/mini-jit-l3
lectures/5-linking/mini-jit/mini-jit-got
lectures/5-linking/mini-jit/mini-jit-lazy
lectures/5-linking/mini-jit/mini-jit-scan
lectures/5-linking/mini-jit/mini-jit-unload
lectures/5-linking/mini-jit/model/*.o
lectures/5-linking/mini-jit/ext/*.o

# lectures/4-cpu/mini-cpu: the lab's build products. dram.img is the guest's
# physical memory and disk.img is the ramfs image; both are regenerated by
# `make`, and dram.img is 64 MiB.
lectures/4-cpu/mini-cpu/mini-cpu
lectures/4-cpu/mini-cpu/mini-cpu-ref
lectures/4-cpu/mini-cpu/lab[1-5]
lectures/4-cpu/mini-cpu/mini-cpu-b[1-9]
lectures/4-cpu/mini-cpu/mini-cpu-ext[1-9]
lectures/4-cpu/mini-cpu/guest/hello
lectures/4-cpu/mini-cpu/guest/sum
lectures/4-cpu/mini-cpu/guest/matmul
lectures/4-cpu/mini-cpu/guest/cat
lectures/4-cpu/mini-cpu/guest/deep
lectures/4-cpu/mini-cpu/guest/pattern
lectures/4-cpu/mini-cpu/guest/tee
lectures/4-cpu/mini-cpu/guest/heap
lectures/4-cpu/mini-cpu/guest/block
lectures/4-cpu/mini-cpu/dram.img
lectures/4-cpu/mini-cpu/disk.img
lectures/4-cpu/mini-cpu/*.tr
