digraph compile_pipeline {
  graph [rankdir=LR, bgcolor="transparent", pad=0.08, nodesep=0.18, ranksep=0.16];
  node [shape=rect, style="rounded,filled", fontname="PingFang SC", fontsize=15,
        color="#9FB5C3", penwidth=1.3, width=1.40, height=0.78, margin="0.12,0.08"];
  edge [color="#156082", penwidth=1.7, arrowsize=0.65];

  source [label="mini_ollama.c\nC 源代码", fillcolor="#EAF3F7"];
  pp [label="预处理\n展开源代码", fillcolor="#F3F5F6"];
  cc [label="编译\n生成汇编", fillcolor="#F3F5F6"];
  as [label="汇编\n生成目标文件", fillcolor="#F3F5F6"];
  ld [label="链接\n生成可执行文件", fillcolor="#FFF2E9", color="#E97132"];

  source -> pp -> cc -> as -> ld;
}
