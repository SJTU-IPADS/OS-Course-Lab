digraph mini_boundaries {
  graph [rankdir=LR, bgcolor="transparent", pad=0.08, nodesep=0.22, ranksep=0.30];
  node [shape=rect, style="rounded,filled", color="#9FB5C3", penwidth=1.3,
        fontname="Cascadia Code", fontsize=13, height=0.58, margin="0.13,0.07"];
  edge [color="#156082", penwidth=1.7, arrowsize=0.62, fontname="PingFang SC", fontsize=11];

  fread [label="fopen / fread", fillcolor="#EAF3F7"];
  libc1 [label="libc 缓冲", fillcolor="#F3F5F6"];
  fileapi [label="内核文件接口", fillcolor="#FFF2E9"];
  storage [label="页缓存 / 存储", fillcolor="#FCE9DF"];

  loop [label="for (...) score += ...", fillcolor="#EAF3F7"];
  compiler [label="编译器", fillcolor="#F3F5F6"];
  isa [label="x86-64 指令", fillcolor="#FFF2E9"];
  cpu [label="CPU 寄存器 / ALU", fillcolor="#FCE9DF"];

  printf [label="printf", fillcolor="#EAF3F7"];
  libc2 [label="libc 格式化", fillcolor="#F3F5F6"];
  write [label="内核 write", fillcolor="#FFF2E9"];
  terminal [label="终端输出", fillcolor="#FCE9DF"];

  fread -> libc1 -> fileapi -> storage;
  loop -> compiler -> isa -> cpu;
  printf -> libc2 -> write -> terminal;
  {rank=same; fread; loop; printf;}
  {rank=same; libc1; compiler; libc2;}
  {rank=same; fileapi; isa; write;}
  {rank=same; storage; cpu; terminal;}
}
