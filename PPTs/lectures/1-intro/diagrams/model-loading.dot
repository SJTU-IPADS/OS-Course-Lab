digraph model_loading {
  graph [rankdir=LR, bgcolor="transparent", pad=0.08, nodesep=0.18, ranksep=0.24];
  node [shape=rect, style="rounded,filled", fontname="PingFang SC", fontsize=15,
        color="#9FB5C3", penwidth=1.3, width=1.55, height=0.85, margin="0.12,0.08"];
  edge [color="#156082", penwidth=1.7, arrowsize=0.65];

  file [label="存储设备上的\n模型文件", fillcolor="#EAF3F7"];
  mapping [label="进程虚拟\n地址", fillcolor="#F3F5F6"];
  cache [label="DRAM 中的文件页\n（操作系统页缓存）", fillcolor="#EAF3F7", width=2.35];
  cpu [label="CPU\n计算", fillcolor="#FCE9DF"];
  device [label="GPU 内存\n（可选）", fillcolor="#FFF2E9"];
  gpu [label="GPU\n计算", fillcolor="#FCE9DF"];

  file -> cache [label=" 按需装入页面 ", fontname="PingFang SC", fontsize=12];
  mapping -> cache [label=" 映射到 ", fontname="PingFang SC", fontsize=12];
  cache -> cpu [label=" 读取 ", fontname="PingFang SC", fontsize=12];
  cache -> device [label=" 可选传输 ", fontname="PingFang SC", fontsize=12];
  device -> gpu [label=" 读取 ", fontname="PingFang SC", fontsize=12];
}
